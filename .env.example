# Wallhaven API (optional - increases rate limits)
WALLHAVEN_API_KEY=xxxxxxxx

# Backend
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Secondary Providers
# Wallpapers.com API key (optional - for authenticated API access)
WALLPAPERSCOM_API_KEY=wpc_your_api_key_here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
